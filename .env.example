# IBVAP Environment Configuration Example

# Application Setup
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=ibvap-secret-key-change-in-production

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
WEBSOCKET_PATH=/ws/live

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./data/ibvap.db

# AI & Computer Vision Settings
YOLO_MODEL_NAME=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
YOLO_IOU_THRESHOLD=0.45
PREFERRED_DEVICE=auto  # Options: auto, mps, cuda, cpu

# ANPR / OCR Settings
ANPR_MIN_CONFIDENCE=0.60
OCR_LANGUAGES=en

# Storage & Paths
EVIDENCE_DIR=./data/evidence
MODELS_DIR=./data/models
VIDEOS_DIR=./data/videos

# Development RTSP / Video Source Defaults
DEFAULT_VIDEO_SOURCE=./data/videos/sample.mp4
CAMERA_1_SOURCE=./data/videos/Vehicle Dataset Sample.mp4
CAMERA_2_SOURCE=./data/videos/Crowd Dataset Sample.mp4
