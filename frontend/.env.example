# IBVAP Cloud / Vercel Environment Variables
# If left blank, the platform automatically runs in Standalone Showcase Simulation mode.
# When your FastAPI backend is deployed on Render/Railway/VPS or tunneled via Cloudflare/ngrok, provide:
VITE_API_URL=https://your-backend-domain.com/api/v1
VITE_WS_URL=wss://your-backend-domain.com/ws/live
